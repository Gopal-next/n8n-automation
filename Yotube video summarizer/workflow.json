    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst combined = items\n  .map((item, index) => {\n    const summary = item.json.output?.[0]?.content?.[0]?.text || '';\n\n    return summary;\n  })\n  .filter(summary => summary.trim() !== '')\n  .join('\\n\\n');\n\nreturn [\n  {\n    json: {\n      combined_summary: combined\n    }\n  }\n];"
      },
